# Google OAuth client (from Google Cloud Console → APIs & Services → Credentials)
# Local: Desktop app is fine. Railway: use a Web application client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local desktop/web redirect (match the OAuth client):
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/oauth2callback
# Railway example:
# GOOGLE_REDIRECT_URI=https://<your-service>.up.railway.app/oauth2callback

# Path to persisted OAuth token JSON (local or Railway Volume mount, e.g. /data/token.json)
GOOGLE_TOKEN_STORAGE=token.json

# Optional: refresh token as Railway secret (alternative / backup to file storage)
# GOOGLE_REFRESH_TOKEN=

# Optional: use broader Docs scope only if drive.file cannot support your flow
# Default scopes are gmail.compose + documents (document-ID append UX)
# GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/documents

LOG_LEVEL=info

# --- HTTP / Railway (npm run start:http) ---
# Required for Streamable HTTP /mcp protection (treat like a password)
# MCP_API_KEY=

# PORT is set by Railway automatically; default 3000 for local HTTP
# PORT=3000
# HOST=0.0.0.0

# Enable only while completing first Google login on the hosted service
# ENABLE_OAUTH_SETUP=false

# Optional Host header allow-list (comma-separated). Recommended on Railway:
# ALLOWED_HOSTS=<your-service>.up.railway.app
